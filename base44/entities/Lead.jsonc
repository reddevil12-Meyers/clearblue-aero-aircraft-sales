{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "lead_source": {
      "type": "string",
      "title": "Lead Source",
      "enum": [
        "Single-Engine Form",
        "Multi-Engine Form",
        "Contact Form",
        "Website",
        "Referral",
        "Trade-A-Plane",
        "Controller",
        "AirMart",
        "Cold Call",
        "Trade Show",
        "Social Media",
        "Manual",
        "Other"
      ],
      "default": "Manual"
    },
    "lead_type": {
      "type": "string",
      "title": "Lead Type",
      "enum": [
        "Buyer",
        "Seller",
        "Both",
        "Appraisal"
      ],
      "default": "Buyer"
    },
    "aircraft_interest": {
      "type": "string",
      "title": "Aircraft of Interest"
    },
    "aircraft_summary": {
      "type": "string",
      "title": "Aircraft Summary"
    },
    "message": {
      "type": "string",
      "title": "Message / Inquiry"
    },
    "budget_min": {
      "type": "number",
      "title": "Budget Min ($)"
    },
    "budget_max": {
      "type": "number",
      "title": "Budget Max ($)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "Qualified",
        "Converted",
        "Lost"
      ],
      "default": "New"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (email)",
      "format": "email"
    },
    "converted_client_id": {
      "type": "string",
      "title": "Converted to Client ID"
    },
    "converted_date": {
      "type": "string",
      "title": "Converted Date",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "last_name",
    "lead_source",
    "status"
  ]
}