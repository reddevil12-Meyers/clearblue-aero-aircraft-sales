{
  "name": "Activity",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Activity Type",
      "enum": [
        "Call",
        "Email",
        "Meeting",
        "Note",
        "Showing",
        "Follow-up",
        "Document",
        "Task",
        "Other"
      ]
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "client_name": {
      "type": "string",
      "title": "Client Name"
    },
    "deal_id": {
      "type": "string",
      "title": "Deal ID"
    },
    "aircraft_id": {
      "type": "string",
      "title": "Aircraft ID"
    },
    "date": {
      "type": "string",
      "title": "Date",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "title": "Due Date",
      "format": "date-time"
    },
    "completed": {
      "type": "boolean",
      "title": "Completed",
      "default": false
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Open",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Open"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "Low",
        "Normal",
        "High",
        "Urgent"
      ],
      "default": "Normal"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assigned To (email)"
    },
    "assigned_to_name": {
      "type": "string",
      "title": "Assigned To Name"
    },
    "outcome": {
      "type": "string",
      "title": "Outcome / Result"
    }
  },
  "required": [
    "type",
    "subject"
  ]
}