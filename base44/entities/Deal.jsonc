{
  "name": "Deal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Deal Title"
    },
    "aircraft_id": {
      "type": "string",
      "title": "Aircraft ID"
    },
    "aircraft_summary": {
      "type": "string",
      "title": "Aircraft Summary"
    },
    "buyer_id": {
      "type": "string",
      "title": "Buyer (Client ID)"
    },
    "buyer_name": {
      "type": "string",
      "title": "Buyer Name"
    },
    "seller_id": {
      "type": "string",
      "title": "Owner (Client ID)"
    },
    "seller_name": {
      "type": "string",
      "title": "Owner Name"
    },
    "stage": {
      "type": "string",
      "title": "Deal Stage",
      "enum": [
        "Lead",
        "Qualification",
        "Showing",
        "Offer",
        "Negotiation",
        "Pre-Buy Inspection",
        "Escrow",
        "Closing",
        "Closed Won",
        "Closed Lost"
      ],
      "default": "Lead"
    },
    "asking_price": {
      "type": "number",
      "title": "Asking Price ($)"
    },
    "offer_price": {
      "type": "number",
      "title": "Offer Price ($)"
    },
    "agreed_price": {
      "type": "number",
      "title": "Agreed Price ($)"
    },
    "deposit_amount": {
      "type": "number",
      "title": "Deposit Amount ($)"
    },
    "commission_rate": {
      "type": "number",
      "title": "Commission Rate (%)"
    },
    "commission_amount": {
      "type": "number",
      "title": "Commission Amount ($)"
    },
    "outside_broker_commission": {
      "type": "number",
      "title": "Outside Broker Commission ($)"
    },
    "expected_close_date": {
      "type": "string",
      "title": "Expected Close Date",
      "format": "date"
    },
    "actual_close_date": {
      "type": "string",
      "title": "Actual Close Date",
      "format": "date"
    },
    "escrow_company": {
      "type": "string",
      "title": "Escrow/Title Company"
    },
    "escrow_fee": {
      "type": "number",
      "title": "Escrow Fee ($)"
    },
    "prebuy_facility": {
      "type": "string",
      "title": "Pre-Buy Inspection Facility"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Urgent"
      ],
      "default": "Medium"
    },
    "what_conveys": {
      "type": "string",
      "title": "What Conveys with Sale"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "document_urls": {
      "type": "array",
      "title": "Generated Documents",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "title",
    "stage"
  ]
}