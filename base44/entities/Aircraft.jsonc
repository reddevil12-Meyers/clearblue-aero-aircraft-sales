{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string",
      "title": "Registration (N-Number)"
    },
    "make": {
      "type": "string",
      "title": "Make",
      "enum": [
        "Cessna",
        "Piper",
        "Beechcraft",
        "Cirrus",
        "Mooney",
        "Diamond",
        "Socata",
        "Grumman",
        "Globe",
        "Aero Commander",
        "Commander",
        "Meyers",
        "Stinson",
        "Vans Aircraft",
        "Glasair",
        "Pilatus",
        "TBM",
        "Daher",
        "Epic",
        "Quest",
        "Textron",
        "Hawker",
        "Embraer",
        "Bombardier",
        "Gulfstream",
        "Dassault",
        "Waco",
        "Other"
      ]
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "year": {
      "type": "number",
      "title": "Year of Manufacture"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "total_time": {
      "type": "number",
      "title": "Total Time (Hours)"
    },
    "engine_time_smoh": {
      "type": "number",
      "title": "Engine Time (Hours)"
    },
    "engine_time_type": {
      "type": "string",
      "title": "Engine Time Type",
      "enum": [
        "SMOH",
        "SNEW"
      ],
      "default": "SMOH"
    },
    "engine_top_overhaul": {
      "type": "number",
      "title": "Engine Top Overhaul (hrs)"
    },
    "engine_time_since_new": {
      "type": "number",
      "title": "Engine Time Since New (hrs)"
    },
    "engine_manufacturer": {
      "type": "string",
      "title": "Engine Manufacturer"
    },
    "engine_model": {
      "type": "string",
      "title": "Engine Model"
    },
    "num_engines": {
      "type": "string",
      "title": "Engines",
      "enum": [
        "Single",
        "Multi-Engine"
      ],
      "default": "Single"
    },
    "engine_type": {
      "type": "string",
      "title": "Engine Type",
      "enum": [
        "Piston",
        "Turbo",
        "Turboprop",
        "Turbojet",
        "Turbofan"
      ]
    },
    "engine2_time_smoh": {
      "type": "number",
      "title": "Engine 2 Time (Hours)"
    },
    "engine2_time_type": {
      "type": "string",
      "title": "Engine 2 Time Type",
      "enum": [
        "SMOH",
        "SNEW"
      ],
      "default": "SMOH"
    },
    "engine2_top_overhaul": {
      "type": "number",
      "title": "Engine 2 Top Overhaul (hrs)"
    },
    "engine2_time_since_new": {
      "type": "number",
      "title": "Engine 2 Time Since New (hrs)"
    },
    "propeller_manufacturer": {
      "type": "string",
      "title": "Propeller Manufacturer"
    },
    "propeller_model": {
      "type": "string",
      "title": "Propeller Model"
    },
    "propeller_time": {
      "type": "number",
      "title": "Propeller Total Time (Hours)"
    },
    "propeller2_time": {
      "type": "number",
      "title": "Propeller 2 Total Time (Hours)"
    },
    "avionics_suite": {
      "type": "string",
      "title": "Avionics Suite",
      "enum": [
        "Garmin",
        "Garmin G1000",
        "Garmin G3X",
        "Garmin GTN 750/650",
        "Avidyne IFD",
        "Aspen EFD",
        "Dynon HDX",
        "King Digital",
        "Collins Pro Line",
        "Honeywell Primus",
        "Steam Gauges",
        "Mixed/Upgraded",
        "Other"
      ]
    },
    "avionics_details": {
      "type": "string",
      "title": "Avionics Details"
    },
    "interior_condition": {
      "type": "string",
      "title": "Interior Condition",
      "enum": [
        "New/Refurbished",
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "exterior_condition": {
      "type": "string",
      "title": "Exterior Condition",
      "enum": [
        "New/Refurbished",
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "paint_year": {
      "type": "number",
      "title": "Paint Year"
    },
    "interior_year": {
      "type": "number",
      "title": "Interior Year"
    },
    "damage_history": {
      "type": "string",
      "title": "Damage History",
      "enum": [
        "None",
        "Minor",
        "Major",
        "Unknown"
      ]
    },
    "damage_details": {
      "type": "string",
      "title": "Damage History Details"
    },
    "annual_due": {
      "type": "string",
      "title": "Annual Inspection Due",
      "format": "date"
    },
    "adsb_compliant": {
      "type": "boolean",
      "title": "ADS-B Out Compliant"
    },
    "factory_air_conditioning": {
      "type": "boolean",
      "title": "Factory Air Conditioning"
    },
    "useful_load": {
      "type": "number",
      "title": "Useful Load (lbs)"
    },
    "fuel_capacity": {
      "type": "number",
      "title": "Fuel Capacity (gal)"
    },
    "cruise_speed": {
      "type": "number",
      "title": "Cruise Speed (kts)"
    },
    "stall_speed": {
      "type": "number",
      "title": "Stall Speed (kts)"
    },
    "max_speed": {
      "type": "number",
      "title": "Max Speed (kts)"
    },
    "range_nm": {
      "type": "number",
      "title": "Range (nm)"
    },
    "service_ceiling": {
      "type": "number",
      "title": "Service Ceiling (ft)"
    },
    "rate_of_climb": {
      "type": "number",
      "title": "Rate of Climb (fpm)"
    },
    "takeoff_distance": {
      "type": "number",
      "title": "Takeoff Distance (ft)"
    },
    "landing_distance": {
      "type": "number",
      "title": "Landing Distance (ft)"
    },
    "fuel_burn_gph": {
      "type": "number",
      "title": "Fuel Burn (gph)"
    },
    "empty_weight": {
      "type": "number",
      "title": "Empty Weight (lbs)"
    },
    "max_takeoff_weight": {
      "type": "number",
      "title": "Max Takeoff Weight (lbs)"
    },
    "wingspan_ft": {
      "type": "number",
      "title": "Wingspan (ft)"
    },
    "length_ft": {
      "type": "number",
      "title": "Length (ft)"
    },
    "payload_lbs": {
      "type": "number",
      "title": "Payload (lbs)"
    },
    "asking_price": {
      "type": "number",
      "title": "Initial List Price ($)"
    },
    "price_drop": {
      "type": "number",
      "title": "Price Drop ($)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Lead",
        "Coming Soon",
        "Available",
        "For Lease",
        "Under Contract",
        "Closing",
        "Sold",
        "Off Market",
        "Appraisal Only"
      ],
      "default": "Available"
    },
    "location": {
      "type": "string",
      "title": "Location (Airport)"
    },
    "listing_partner": {
      "type": "string",
      "title": "Listing in Partnership with"
    },
    "images": {
      "type": "array",
      "title": "Aircraft Images",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "image_alts": {
      "type": "array",
      "title": "Image Alt Descriptions (AI-generated)",
      "items": {
        "type": "string"
      }
    },
    "logbook_urls": {
      "type": "array",
      "title": "Scanned Logbook URLs",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "seller_id": {
      "type": "string",
      "title": "Owner (Client ID)"
    },
    "zoho_id": {
      "type": "string",
      "title": "Zoho Record ID"
    },
    "notes": {
      "type": "string",
      "title": "Description"
    },
    "other": {
      "type": "string",
      "title": "Other"
    },
    "online_listing_description": {
      "type": "string",
      "title": "Online Listing Description (Barnstormers / Trade-A-Plane)"
    },
    "show_on_public": {
      "type": "boolean",
      "title": "Show on Public Inventory",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "title": "Featured Aircraft",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order"
    },
    "published_sites": {
      "type": "array",
      "title": "Published to Sites",
      "items": {
        "type": "string",
        "enum": [
          "clearblue",
          "beechcraft",
          "gardner"
        ]
      },
      "default": []
    },
    "tail_number": {
      "type": "string",
      "title": "Tail Number (ADS-B)",
      "description": "Uppercase, trimmed (e.g. N123AB)"
    },
    "icao24": {
      "type": "string",
      "title": "ICAO 24-bit Address (hex)",
      "pattern": "^[0-9a-f]{6}$",
      "description": "Lowercase 6-character hex"
    },
    "icao24_source": {
      "type": "string",
      "title": "ICAO24 Source"
    },
    "icao24_verified_at": {
      "type": "string",
      "title": "ICAO24 Verified At",
      "format": "date-time"
    },
    "adsb_last_seen_at": {
      "type": "string",
      "title": "ADS-B Last Seen At",
      "format": "date-time"
    },
    "adsb_last_lat": {
      "type": "number",
      "title": "ADS-B Last Latitude",
      "minimum": -90,
      "maximum": 90
    },
    "adsb_last_lon": {
      "type": "number",
      "title": "ADS-B Last Longitude",
      "minimum": -180,
      "maximum": 180
    },
    "adsb_status": {
      "type": "string",
      "title": "ADS-B Status",
      "enum": [
        "unknown",
        "active",
        "quiet",
        "no_hex",
        "error"
      ],
      "default": "unknown"
    },
    "adsb_public_visible": {
      "type": "boolean",
      "title": "Show ADS-B Info on Public Listing",
      "default": false
    },
    "adsb_summary_text": {
      "type": "string",
      "title": "ADS-B Summary Text"
    },
    "priority_adsb": {
      "type": "boolean",
      "title": "Priority ADS-B Ingest",
      "description": "Always include this aircraft in the nightly flight-history ingest, even past the 40-aircraft cap",
      "default": false
    },
    "instruments": {
      "type": "array",
      "title": "Instruments",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Instrument Name"
          },
          "make": {
            "type": "string",
            "title": "Make / Manufacturer"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "enum": [
              "New",
              "Excellent",
              "Good",
              "Fair",
              "Poor",
              "Inoperative"
            ]
          },
          "last_calibration": {
            "type": "string",
            "title": "Last Calibration / Check Date"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        }
      }
    }
  },
  "required": [
    "make",
    "model",
    "year",
    "registration"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        }
      ]
    }
  }
}