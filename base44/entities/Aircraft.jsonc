{
  "name": "Aircraft",
  "type": "object",
  "properties": {
    "registration": {
      "type": "string",
      "title": "Registration (N-Number)"
    },
    "make": {
      "type": "string",
      "title": "Make",
      "enum": [
        "Cessna",
        "Piper",
        "Beechcraft",
        "Cirrus",
        "Mooney",
        "Diamond",
        "Socata",
        "Grumman",
        "Aero Commander",
        "Commander",
        "Meyers",
        "Stinson",
        "Vans Aircraft",
        "Glasair",
        "Pilatus",
        "TBM",
        "Daher",
        "Epic",
        "Quest",
        "Textron",
        "Hawker",
        "Embraer",
        "Bombardier",
        "Gulfstream",
        "Dassault",
        "Other"
      ]
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "year": {
      "type": "number",
      "title": "Year of Manufacture"
    },
    "serial_number": {
      "type": "string",
      "title": "Serial Number"
    },
    "total_time": {
      "type": "number",
      "title": "Total Time (Hours)"
    },
    "engine_time_smoh": {
      "type": "number",
      "title": "Engine Time (Hours)"
    },
    "engine_time_type": {
      "type": "string",
      "title": "Engine Time Type",
      "enum": [
        "SMOH",
        "SNEW"
      ],
      "default": "SMOH"
    },
    "engine_manufacturer": {
      "type": "string",
      "title": "Engine Manufacturer"
    },
    "engine_model": {
      "type": "string",
      "title": "Engine Model"
    },
    "num_engines": {
      "type": "number",
      "title": "Number of Engines",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "engine_type": {
      "type": "string",
      "title": "Engine Type",
      "enum": [
        "Piston",
        "Turboprop",
        "Turbojet",
        "Turbofan"
      ]
    },
    "engine2_manufacturer": {
      "type": "string",
      "title": "Engine 2 Manufacturer"
    },
    "engine2_model": {
      "type": "string",
      "title": "Engine 2 Model"
    },
    "engine2_time_smoh": {
      "type": "number",
      "title": "Engine 2 Time (Hours)"
    },
    "engine2_time_type": {
      "type": "string",
      "title": "Engine 2 Time Type",
      "enum": [
        "SMOH",
        "SNEW"
      ],
      "default": "SMOH"
    },
    "propeller_manufacturer": {
      "type": "string",
      "title": "Propeller Manufacturer"
    },
    "propeller_model": {
      "type": "string",
      "title": "Propeller Model"
    },
    "propeller_time": {
      "type": "number",
      "title": "Propeller Total Time (Hours)"
    },
    "propeller2_manufacturer": {
      "type": "string",
      "title": "Propeller 2 Manufacturer"
    },
    "propeller2_model": {
      "type": "string",
      "title": "Propeller 2 Model"
    },
    "propeller2_time": {
      "type": "number",
      "title": "Propeller 2 Total Time (Hours)"
    },
    "avionics_suite": {
      "type": "string",
      "title": "Avionics Suite",
      "enum": [
        "Garmin G1000",
        "Garmin G3X",
        "Garmin GTN 750/650",
        "Avidyne IFD",
        "Aspen EFD",
        "King Digital",
        "Collins Pro Line",
        "Honeywell Primus",
        "Steam Gauges",
        "Mixed/Upgraded",
        "Other"
      ]
    },
    "avionics_details": {
      "type": "string",
      "title": "Avionics Details"
    },
    "interior_condition": {
      "type": "string",
      "title": "Interior Condition",
      "enum": [
        "New/Refurbished",
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "exterior_condition": {
      "type": "string",
      "title": "Exterior Condition",
      "enum": [
        "New/Refurbished",
        "Excellent",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "paint_year": {
      "type": "number",
      "title": "Paint Year"
    },
    "interior_year": {
      "type": "number",
      "title": "Interior Year"
    },
    "damage_history": {
      "type": "string",
      "title": "Damage History",
      "enum": [
        "None",
        "Minor",
        "Major",
        "Unknown"
      ]
    },
    "damage_details": {
      "type": "string",
      "title": "Damage History Details"
    },
    "annual_due": {
      "type": "string",
      "title": "Annual Inspection Due",
      "format": "date"
    },
    "adsb_compliant": {
      "type": "boolean",
      "title": "ADS-B Out Compliant"
    },
    "factory_air_conditioning": {
      "type": "boolean",
      "title": "Factory Air Conditioning"
    },
    "useful_load": {
      "type": "number",
      "title": "Useful Load (lbs)"
    },
    "fuel_capacity": {
      "type": "number",
      "title": "Fuel Capacity (gal)"
    },
    "asking_price": {
      "type": "number",
      "title": "Asking Price ($)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Available",
        "Under Contract",
        "Sold",
        "Off Market",
        "Appraisal Only"
      ],
      "default": "Available"
    },
    "location": {
      "type": "string",
      "title": "Location (Airport)"
    },
    "listing_partner": {
      "type": "string",
      "title": "Listing in Partnership with"
    },
    "images": {
      "type": "array",
      "title": "Aircraft Images",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "logbook_urls": {
      "type": "array",
      "title": "Scanned Logbook URLs",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "seller_id": {
      "type": "string",
      "title": "Seller (Client ID)"
    },
    "notes": {
      "type": "string",
      "title": "Description"
    },
    "other": {
      "type": "string",
      "title": "Other"
    },
    "show_on_public": {
      "type": "boolean",
      "title": "Show on Public Inventory",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "title": "Featured Aircraft",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order"
    },
    "published_sites": {
      "type": "array",
      "title": "Published to Sites",
      "items": {
        "type": "string",
        "enum": [
          "clearblue",
          "beechcraft",
          "gardner"
        ]
      },
      "default": []
    },
    "instruments": {
      "type": "array",
      "title": "Instruments",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Instrument Name"
          },
          "make": {
            "type": "string",
            "title": "Make / Manufacturer"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "serial_number": {
            "type": "string",
            "title": "Serial Number"
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "enum": [
              "Excellent",
              "Good",
              "Fair",
              "Poor",
              "Inoperative"
            ]
          },
          "last_calibration": {
            "type": "string",
            "title": "Last Calibration / Check Date"
          },
          "notes": {
            "type": "string",
            "title": "Notes"
          }
        }
      }
    }
  },
  "required": [
    "make",
    "model",
    "year",
    "registration"
  ]
}