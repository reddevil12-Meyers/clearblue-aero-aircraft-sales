{
  "name": "ApiTokenCache",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "title": "Provider"
    },
    "access_token": {
      "type": "string",
      "title": "Access Token"
    },
    "expires_at": {
      "type": "string",
      "title": "Expires At",
      "format": "date-time"
    }
  },
  "required": [
    "provider",
    "expires_at"
  ]
}