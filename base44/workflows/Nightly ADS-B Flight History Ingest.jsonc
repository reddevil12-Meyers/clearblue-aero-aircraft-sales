  "name": "Nightly ADS-B Flight History Ingest",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_adsb_flight_history_ingest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "ingest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ingestOpenSkyFlightHistory",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Ingest flight history",
            "description": "Walk 2-day OpenSky windows per aircraft and upsert flight events"
          }
        }
      }
    ]
