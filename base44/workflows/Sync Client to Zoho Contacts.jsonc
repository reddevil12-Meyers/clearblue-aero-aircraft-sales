{
  "name": "Sync Client to Zoho Contacts",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8,20 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_client_to_zoho_contacts",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_clients": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "batchSyncClientsToZoho",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Push clients to Zoho",
            "description": "Upsert clients changed in the last 24 hours"
          }
        }
      }
    ]
  },
  "description": "Pushes Client changes to Zoho CRM Contacts twice a day (8 AM and 8 PM ET) instead of on every edit.",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncToZoho"
  }
}