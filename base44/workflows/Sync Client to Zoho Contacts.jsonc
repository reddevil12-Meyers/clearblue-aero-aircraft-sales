{
  "name": "Sync Client to Zoho Contacts",
  "description": "Pushes Client (Contact) creates/updates to Zoho CRM Contacts in real time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Client"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_client_to_zoho_contacts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToZoho",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncToZoho"
  }
}