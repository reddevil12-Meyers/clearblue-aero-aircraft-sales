{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "zoho_two_way_sync_30_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pullFromZoho",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-12T13:36:51.624000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Zoho Two-Way Sync (30 min)",
  "description": "Polls Zoho CRM every 30 minutes for recent edits to Contacts, Deals, and Aircraft and pulls them back into Base44 (Base44 wins on conflict)."
}