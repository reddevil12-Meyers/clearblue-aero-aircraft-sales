{
  "name": "Sync Aircraft to Zoho",
  "description": "Pushes Aircraft creates/updates to the Zoho CRM Aircraft custom module in real time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Aircraft"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_aircraft_to_zoho",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToZoho",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncToZoho"
  }
}