{
  "name": "Weekly Aircraft Market Report",
  "description": "Gathers aircraft listings/sales across major sites and emails a weekly market report to sales@flyclearblue.com",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * 0",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_aircraft_market_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runMarketReport",
            "args": {
              "auto_finalize": true,
              "makes": [
                "Cessna",
                "Piper",
                "Beechcraft",
                "Cirrus",
                "Mooney",
                "Diamond"
              ]
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "runMarketReport"
  }
}